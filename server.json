{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JerryYangAI/taoyuan-mcp",
  "title": "Taoyuan Music",
  "description": "Write an original song for one person: lyrics, two full versions and cover art in about a minute.",
  "websiteUrl": "https://www.musicsforyou.com/developers?lang=en",
  "repository": {
    "url": "https://github.com/JerryYangAI/taoyuan-mcp",
    "source": "github"
  },
  "version": "1.1.1",
  "icons": [
    { "src": "https://www.musicsforyou.com/icon-512.png", "mimeType": "image/png", "sizes": ["512x512"] }
  ],
  "remotes": [
    { "type": "streamable-http", "url": "https://api.musicsforyou.com/mcp" }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "taoyuan-mcp",
      "version": "1.1.1",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "TAOYUAN_API_KEY",
          "description": "API key from https://www.musicsforyou.com/developers (starts with ty_live_)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
